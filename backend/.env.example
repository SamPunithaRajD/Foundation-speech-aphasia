# FoundationSpeech-Aphasia backend configuration.
# Copy to backend/.env and adjust. Every variable is optional; defaults shown.
# Never commit secrets. No secrets are required by this prototype.

# --- API ---------------------------------------------------------------
FSA_HOST=127.0.0.1
FSA_PORT=8000
FSA_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
FSA_LOG_LEVEL=INFO

# --- Storage / privacy ---------------------------------------------------
FSA_DATA_DIR=./data
# sqlite:///absolute/or/relative/path.db  (default: <FSA_DATA_DIR>/foundationspeech.db)
FSA_DATABASE_URL=
# Temporary inference workspace; uploads are deleted after decoding unless FSA_RETAIN_AUDIO=true
FSA_TEMP_DIR=./data/tmp
FSA_RETAIN_AUDIO=false
# Days to keep analysis records; 0 = keep indefinitely (default). A positive value DELETES older records at startup.
FSA_RETENTION_DAYS=0
# Filenames can contain identifiers; stored as "speech-sample.<ext>" unless enabled
FSA_STORE_ORIGINAL_FILENAME=false

# --- Upload validation ---------------------------------------------------
FSA_MAX_UPLOAD_MB=100
FSA_MAX_DURATION_SECONDS=600
FSA_MIN_DURATION_SECONDS=0.5

# --- Preprocessing -------------------------------------------------------
FSA_TARGET_SAMPLE_RATE=16000
FSA_NORMALIZE_PEAK_DBFS=-1
FSA_HIGHPASS_HZ=0
FSA_VAD_ENABLED=true
FSA_VAD_AGGRESSIVENESS=2
FSA_VAD_MERGE_GAP_MS=300
FSA_VAD_MIN_SEGMENT_MS=150

# --- Models / hardware ---------------------------------------------------
# auto | cpu | cuda   (cuda requires a CUDA build of PyTorch, see README)
FSA_DEVICE=auto
# Weights are NEVER downloaded unless this is true (or scripts/download_models.py is run)
FSA_ALLOW_MODEL_DOWNLOAD=false
# Hugging Face cache (default ~/.cache/huggingface/hub) and Whisper cache (default ~/.cache/whisper)
FSA_HF_CACHE_DIR=
FSA_WHISPER_CACHE_DIR=
# Hugging Face model IDs or local directories
FSA_WAV2VEC2_MODEL_ID=facebook/wav2vec2-base
FSA_HUBERT_MODEL_ID=facebook/hubert-base-ls960
FSA_WAVLM_MODEL_ID=microsoft/wavlm-base-plus
# openai-whisper checkpoint used for encoder embeddings
FSA_WHISPER_ENCODER_MODEL=tiny
FSA_DEFAULT_EMBEDDING_MODELS=["whisper_encoder"]
# Chunk length for embedding extraction (attention memory grows quadratically with this)
FSA_MAX_EMBEDDING_SECONDS=30

# --- ASR -----------------------------------------------------------------
FSA_ASR_ENABLED=true
FSA_ASR_MODEL=tiny
# empty = automatic language detection
FSA_ASR_LANGUAGE=
FSA_ASR_WORD_TIMESTAMPS=true

# --- Features / fusion ---------------------------------------------------
FSA_PAUSE_THRESHOLD_MS=250
FSA_MATTR_WINDOW=25
# concatenate | weighted_concatenate
FSA_FUSION_STRATEGY=concatenate
# l2 | none | fitted
FSA_FUSION_BLOCK_NORMALIZATION=l2

# --- Severity classifier -------------------------------------------------
# Directory holding the PROMOTED severity bundle (written only by `python -m app.training.promote`). Absent => MODEL_NOT_READY
FSA_SEVERITY_MODEL_DIR=./artifacts/severity

FSA_MAX_CONCURRENT_JOBS=1

# No score is reported when inputs are far outside the training distribution (0 disables the check)
FSA_OOD_FACTOR=1.5

# Serve a promoted PILOT_CROSS_VALIDATED bundle (small-sample model, cross-validated only). Off by default.
FSA_ALLOW_PILOT_MODEL=false

# No score is reported when a named feature is outside its training range by more than this many training SDs
FSA_RANGE_MARGIN_SD=0.5
